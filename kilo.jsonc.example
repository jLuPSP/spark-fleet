{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "openai-compatible/qwen3-1.7b-local",
  "provider": {
    "openai-compatible": {
      "options": {
        "apiKey": "{env:SPARK_FLEET_TOKEN}",
        "baseURL": "{env:SPARK_FLEET_BASE_URL}",
        "timeout": 300000
      },
      "models": {
        "qwen3-1.7b-local": {
          "name": "Spark Fleet Qwen 3 1.7B",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  }
}
