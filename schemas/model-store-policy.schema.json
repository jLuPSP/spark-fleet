{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark-fleet/schemas/model-store-policy.schema.json",
  "title": "approved internal model-store locations",
  "type": "object",
  "additionalProperties": false,
  "required": ["allowed_artifact_prefixes"],
  "properties": {
    "allowed_artifact_prefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://\\S+/$" }
    }
  }
}
