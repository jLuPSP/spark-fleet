{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark-fleet/schemas/versions.schema.json",
  "title": "spark-fleet pinned images and host requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "images"],
  "properties": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k3s", "argo_cd", "kuberay_operator", "ray", "gpu_operator", "nvidia_device_plugin"],
      "properties": {
        "k3s": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+\\+k3s[0-9]+$" },
        "argo_cd": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "kuberay_operator": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "ray": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "gpu_operator": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "nvidia_device_plugin": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vllm", "ray_llm", "apisix", "python"],
      "properties": {
        "vllm": { "$ref": "#/$defs/image" },
        "ray_llm": { "$ref": "#/$defs/image" },
        "apisix": { "$ref": "#/$defs/image" },
        "python": {
          "description": "Base image for locally-built helper containers (mock nodes, dev JWKS server).",
          "$ref": "#/$defs/image"
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "tag", "digest"],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[a-z0-9]+([._/-][a-z0-9]+)*$"
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "digest": {
          "description": "sha256 manifest digest. Null only during bootstrap; CI requires non-null (scripts/validate.py --require-digests).",
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
